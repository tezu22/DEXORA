name: NEON RIG - Auto price + GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:
  schedule:
    # 02:00 and 14:00 in Vietnam (UTC+07:00); GitHub may run late.
    - cron: '0 7,19 * * *'

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: 'neon-rig-pages'
  cancel-in-progress: false

jobs:
  update-and-deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install parser dependencies
        run: python -m pip install --disable-pip-version-check 'requests>=2.32,<3' 'beautifulsoup4>=4.12,<5'
      - name: Fetch product sale prices (respect robots.txt)
        run: python scripts/update_prices.py
      - name: Commit price changes (if any)
        run: |
          if git diff --quiet -- data/prices.json; then
            echo 'No updated quotes to commit.'
          else
            git config user.name 'github-actions[bot]'
            git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
            git add data/prices.json
            git commit -m 'chore: refresh verified PC retailer prices'
            git push
          fi
      - name: Prepare static website
        run: |
          mkdir -p _site/data
          cp index.html _site/index.html
          cp data/prices.json _site/data/prices.json
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site
      - uses: actions/deploy-pages@v4
        id: deployment
